{
  "schema_version": 1,
  "id": "frontend-studio-worldwide-v1",
  "policy_version": "1.1.2",
  "name": "Frontend studio -> independent software/product studios worldwide, excluding India",
  "description": "Independent software development and product studios worldwide, excluding India-based firms, roughly 5–50 staff, with relevant frontend delivery work.",
  "seller": "Hypothetical freelance/boutique React/Next.js frontend development studio (dashboards, client portals, SaaS interfaces). Not a real business.",
  "notes": "Geography is worldwide except India. Confirm company base, size and first-party client work before counting a high-fit prospect. Preserve uncertainty when location is missing.",
  "geography": {
    "countries": [],
    "points": 20,
    "exclude_india": true
  },
  "size": {
    "band": [
      5,
      50
    ],
    "hard_max": 250,
    "in_band_points": 15,
    "above_band_points": -10,
    "below_band_points": 0
  },
  "target_type": {
    "id": "agency_studio",
    "label": "client-services agency/studio",
    "short_label": "agency",
    "identity": [
      {
        "claim": "entity_type:studio_or_agency",
        "strength": "strong",
        "points": 20,
        "rule": "entity_type: studio/agency wording"
      },
      {
        "claim": "entity_type:client_services",
        "strength": "strong",
        "points": 12,
        "rule": "entity_type: builds-for-clients wording (no studio/agency noun)"
      },
      {
        "claim": "entity_type:consulting_engagements",
        "strength": "weak",
        "points": 12,
        "rule": "entity_type: firm's own consulting/client engagements (weak identity)"
      },
      {
        "claim": "capability:client_application_delivery",
        "strength": "weak",
        "points": 0,
        "rule": "first-party account of delivering a client application"
      }
    ],
    "identity_missing_unknown": "entity_type: no self-referential studio/agency description found",
    "identity_missing_reason": "no self-referential studio/agency (or build-for-clients) wording",
    "capabilities": [
      {
        "id": "react",
        "claim": "service:react",
        "points": 6
      },
      {
        "id": "nextjs",
        "claim": "service:nextjs",
        "points": 6
      },
      {
        "id": "typescript",
        "claim": "service:typescript",
        "points": 4
      },
      {
        "id": "frontend",
        "claim": "service:frontend",
        "points": 5
      },
      {
        "id": "web_app",
        "claim": "service:web_app",
        "points": 5
      },
      {
        "id": "custom_software",
        "claim": "service:custom_software",
        "points": 4,
        "counts_for_strong": false
      }
    ],
    "capability_cap": 25,
    "min_capabilities": 1,
    "capability_noun": "capabilities",
    "capability_rule_prefix": "capability: ",
    "capabilities_missing_unknown": "no supported target frontend service found",
    "capabilities_missing_reason": "no target service evidenced as an offering",
    "qualified_reason": "client-service identity or delivery evidenced alongside a separately offered target service",
    "mixed_identity_template": "mixed identity: agency wording alongside vendor/enterprise signals {values}",
    "gate_cap_note": "Location, project evidence, size and named people alone cannot establish studio identity"
  },
  "screens": [
    {
      "rule": "staffing_recruiting",
      "type_id": "staffing",
      "claim": "negative:staffing_recruiting",
      "detail": "homepage describes a staffing/recruiting business"
    }
  ],
  "type_profiles": [
    {
      "id": "enterprise_software",
      "claim": "company_type:enterprise_signal",
      "min_distinct_values": 2,
      "any_value": [
        "listed_company"
      ],
      "shielded_by_strong_identity": true,
      "reason_template": "large/listed-corporation signals {values} and no studio/agency self-description"
    },
    {
      "id": "saas_vendor",
      "claim": "company_type:saas_vendor_signal",
      "min_distinct_values": 3,
      "shielded_by_strong_identity": true,
      "reason_template": "product-vendor signals {values} and no studio/agency self-description",
      "partial_note_template": "some product-vendor signals {values}"
    }
  ],
  "bonuses": [
    {
      "claim": "capability:client_application_delivery",
      "points": 15,
      "rule": "documented client application delivery",
      "requires_target_type": true
    }
  ],
  "penalties": [
    {
      "claim": "negative:staff_augmentation",
      "points": -15,
      "rule": "negative: staff-augmentation model wording"
    },
    {
      "claim": "negative:global_consultancy",
      "points": -10,
      "rule": "negative: global-consultancy wording"
    },
    {
      "claim": "negative:staffing_mention",
      "points": -10,
      "rule": "negative: staffing wording on secondary page"
    }
  ],
  "decision_makers": {
    "role_classes": [
      "founder_ceo",
      "cto_eng",
      "other_leader"
    ],
    "points": 5
  },
  "tiers": {
    "strong": 65,
    "possible": 40
  },
  "strong_requirements": {
    "geography": true,
    "size_in_band": true,
    "min_capabilities": 2
  },
